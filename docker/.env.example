# cp .env.example .env

TWPR_HOSTNAME=proxy.example.com
TWPR_EMAIL=you@example.com

# 32 hex (оставьте пустым — quickstart сгенерирует)
TWPR_SECRET=

HTTP_PORT=80
HTTPS_PORT=443
MTPROXY_WORKERS=1
MTPROXY_MAX_CONNECTIONS=4096
TPROXY_REF=master

