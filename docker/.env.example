# cp .env.example .env

TWPR_HOSTNAME=proxy.example.com
TWPR_EMAIL=you@example.com
TWPR_SECRET=

HTTP_PORT=80
HTTPS_PORT=443
MTPROXY_WORKERS=1
MTPROXY_MAX_CONNECTIONS=4096
TPROXY_REF=master

# Готовые образы (по умолчанию GHCR). Локальная сборка: TWPR_DOCKER_BUILD=1
TWPR_IMAGE_TAG=latest
TWPR_RELAY_IMAGE=ghcr.io/rasmusvraa/tgwebproxyr-relay
TWPR_MTPROXY_IMAGE=ghcr.io/rasmusvraa/tgwebproxyr-mtproxy
TWPR_CADDY_IMAGE=caddy:2.8-alpine

# BOT_TOKEN=
# ALLOWED_CHAT_IDS=
