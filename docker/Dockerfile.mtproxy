# Fast MTProxy image — binary + telegram config from Release (or docker/bin in CI)
FROM debian:bookworm-slim
ARG TWPR_VERSION=1.5.0
ARG USE_LOCAL_BIN=0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl jq iproute2 \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --system --home /nonexistent --shell /usr/sbin/nologin mtproxy \
  && mkdir -p /etc/mtproxy /opt/MTProxy/objs/bin /usr/share/mtproxy-defaults /tmp/bin /run/twpr
COPY docker/bin/ /tmp/bin/
RUN set -eu; \
  if [ "$USE_LOCAL_BIN" = "1" ] && [ -f /tmp/bin/mtproto-proxy-linux-amd64 ]; then \
    cp /tmp/bin/mtproto-proxy-linux-amd64 /opt/MTProxy/objs/bin/mtproto-proxy; \
  else \
    echo ">> download mtproto-proxy v${TWPR_VERSION}"; \
    curl -fsSL --retry 8 --retry-delay 2 --retry-all-errors \
      -o /opt/MTProxy/objs/bin/mtproto-proxy \
      "https://github.com/RasmusVraa/TgWebProxyR/releases/download/v${TWPR_VERSION}/mtproto-proxy-linux-amd64"; \
  fi; \
  chmod 755 /opt/MTProxy/objs/bin/mtproto-proxy; \
  if [ -f /tmp/bin/proxy-secret ] && [ -f /tmp/bin/proxy-multi.conf ]; then \
    cp /tmp/bin/proxy-secret /usr/share/mtproxy-defaults/proxy-secret; \
    cp /tmp/bin/proxy-multi.conf /usr/share/mtproxy-defaults/proxy-multi.conf; \
  else \
    curl -fsSL --retry 8 --retry-delay 2 --retry-all-errors \
      -o /usr/share/mtproxy-defaults/proxy-secret https://core.telegram.org/getProxySecret; \
    curl -fsSL --retry 8 --retry-delay 2 --retry-all-errors \
      -o /usr/share/mtproxy-defaults/proxy-multi.conf https://core.telegram.org/getProxyConfig; \
  fi; \
  cp /usr/share/mtproxy-defaults/proxy-secret /etc/mtproxy/proxy-secret; \
  cp /usr/share/mtproxy-defaults/proxy-multi.conf /etc/mtproxy/proxy-multi.conf; \
  chown -R mtproxy:mtproxy /etc/mtproxy /usr/share/mtproxy-defaults; \
  chmod 640 /etc/mtproxy/proxy-secret /etc/mtproxy/proxy-multi.conf \
           /usr/share/mtproxy-defaults/proxy-secret /usr/share/mtproxy-defaults/proxy-multi.conf; \
  rm -rf /tmp/bin
COPY docker/entrypoint-mtproxy.sh /usr/local/bin/entrypoint-mtproxy.sh
RUN chmod 755 /usr/local/bin/entrypoint-mtproxy.sh
EXPOSE 2398 8888
ENTRYPOINT ["/usr/local/bin/entrypoint-mtproxy.sh"]
